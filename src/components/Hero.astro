---
import SectionContainer from "./ui/SectionContainer.astro";
---

<section class="relative pt-32 pb-20 md:pt-40 md:pb-32">
	<SectionContainer>
		<div class="flex flex-col items-center text-center max-w-4xl mx-auto">
			<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-text-white leading-tight mb-6">
				Transformamos ideas en <span class="text-accent-purple">software personalizado</span>
			</h1>

			<p class="text-lg md:text-xl text-text-gray max-w-2xl mb-10">
				Creamos soluciones digitales a medida que impulsan tu negocio.
				Desde aplicaciones web hasta sistemas complejos, hacemos realidad tu visión.
			</p>

			<div class="flex flex-col sm:flex-row gap-4">
				<a
					href="#contacto"
					class="px-8 py-4 bg-primary-purple hover:bg-accent-purple text-text-white font-semibold rounded-lg transition-colors duration-300"
				>
					Contactanos
				</a>
			</div>
		</div>
	</SectionContainer>
</section>
