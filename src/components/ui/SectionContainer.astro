---
interface Props {
  class?: string;
  maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl';
  centered?: boolean;
}

const { 
  class: className = '', 
  maxWidth = '3xl',
  centered = true 
} = Astro.props;

const maxWidthClasses = {
  'sm': 'max-w-sm',
  'md': 'max-w-md',
  'lg': 'max-w-lg',
  'xl': 'max-w-xl',
  '2xl': 'max-w-2xl',
  '3xl': 'max-w-3xl',
  '4xl': 'max-w-4xl',
  '5xl': 'max-w-5xl',
};
---

<section class={`section-container py-16 md:py-24 ${className}`}>
  <div class={`mx-auto ${maxWidthClasses[maxWidth]} ${centered ? 'text-center' : ''}`}>
    <slot />
  </div>
</section>